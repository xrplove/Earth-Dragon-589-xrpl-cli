# Wallet seed for signing transactions (e.g. sEdV...)
# XRPL_SEED=

# Path to a JSON keyfile containing the seed
# XRPL_KEYFILE=

# Keystore wallet name (used with --from)
# XRPL_FROM=

# Path to keystore password file
# XRPL_PASSWORD_FILE=

# Network: mainnet, testnet, or devnet (default: mainnet)
# XRPL_NETWORK=mainnet

# Custom WebSocket RPC URL (overrides XRPL_NETWORK)
# XRPL_RPC_URL=wss://s1.ripple.com
